# Copia este archivo a ".env" y completa tus propios valores reales.
# El ".env" real NUNCA se sube al repo (ver .gitignore).

# --- Modelo local de Ollama ---
OLLAMA_MODEL=qwen2.5:1.5b

# --- Reporte de Power BI que se incrusta visualmente (opcional) ---
# Se obtienen de la URL de tu reporte en Power BI Service:
# https://app.powerbi.com/groups/{GROUP_ID}/reports/{REPORT_ID}/...
POWERBI_REPORT_URL=
POWERBI_GROUP_ID=
POWERBI_REPORT_ID=

# --- Azure AD (solo si quieres el reporte embebido interactivo) ---
# Ver la guia de registro de la app en Azure AD (Microsoft Entra ID).
AZURE_CLIENT_ID=
AZURE_TENANT_ID=

# --- Login (requiere las tablas COE.User_Admin y COE.Acceso_Log ya creadas
#     en un SQL Server) — sin esto, /login muestra "no configurado" pero el
#     resto de la app funciona igual. ---
DB_SERVER=
DB_DATABASE=
DB_UID=
DB_PWD=

# Firma las cookies de sesion del login. Genera una propia:
# python -c "import secrets; print(secrets.token_hex(32))"
# Si se deja vacia, se genera una aleatoria en cada arranque del servidor
# (las sesiones no sobreviven un reinicio, pero es mejor que una clave fija
# y predecible).
SESSION_SECRET=
